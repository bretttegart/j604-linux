+/* C5: bounded summaries of formats described by m1n1/fw/asc/crash.py.
+ * These read only the normal-memory shadow copy and change no RTKit state.
+ * Keep the original raw dump as evidence if the firmware layout differs.
+ */
+static void apple_rtkit_crashlog_diag_structured(struct apple_rtkit *rtk,
+					       u32 fourcc, u8 *p, size_t len)
+{
+	size_t i, pos = 0, count = 0;
+	u32 n;
+
+	if (fourcc == FOURCC('C', 'c', 's', 't') && len >= 8) {
+		dev_err(rtk->dev, "RTKDIAG Ccst task=%u aux=%08x bytes=%zx\n",
+			get_unaligned_le32(p), get_unaligned_le32(p + 4), len);
+		for (i = 8; len - i >= 8 && count < 64; i += 8, count++) {
+			u64 addr = get_unaligned_le64(p + i);
+
+			if (!addr)
+				break;
+			dev_err(rtk->dev, "RTKDIAG Ccst frame=%zu pc=%016llx\n",
+				count, addr);
+		}
+	} else if (fourcc == FOURCC('C', 'a', 's', 'C') && len >= 48) {
+		dev_err(rtk->dev,
+			"RTKDIAG CasC l2c_sts=%016llx l2c_adr=%016llx l2c_inf=%016llx\n",
+			get_unaligned_le64(p), get_unaligned_le64(p + 8),
+			get_unaligned_le64(p + 16));
+		dev_err(rtk->dev,
+			"RTKDIAG CasC lsu_sts=%016llx fed_sts=%016llx mmu_sts=%016llx\n",
+			get_unaligned_le64(p + 24), get_unaligned_le64(p + 32),
+			get_unaligned_le64(p + 40));
+	} else if (fourcc == FOURCC('C', 'r', 't', 'k')) {
+		while (len - pos >= 72 && count < 64) {
+			n = get_unaligned_le32(p + pos + 40);
+			if (n > (len - pos - 72) / 8) {
+				dev_err(rtk->dev,
+					"RTKDIAG Crtk invalid ptr_count=%u at payload+%zx\n",
+					n, pos);
+				break;
+			}
+			dev_err(rtk->dev,
+				"RTKDIAG Crtk task=%u flags=%04x ptr=%016llx frames=%u name=%.*s\n",
+				get_unaligned_le16(p + pos),
+				get_unaligned_le16(p + pos + 2),
+				get_unaligned_le64(p + pos + 16), n,
+				28, p + pos + 44);
+			pos += 72 + (size_t)n * 8;
+			count++;
+		}
+		if (pos != len)
+			dev_err(rtk->dev,
+				"RTKDIAG Crtk unparsed bytes=%zx at payload+%zx\n",
+				len - pos, pos);
+	}
+}
