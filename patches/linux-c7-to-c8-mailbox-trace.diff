 #include "rtkit-internal.h"
+#include <linux/ktime.h>
+#include <linux/of.h>
+#include <linux/spinlock.h>
+
+/* C8 diagnostic only: no allocation or printk in the mailbox hooks. */
+#define APPLE_RTKIT_DIAG_TRACE_CAPACITY 1024
+
+enum apple_rtkit_diag_event {
+	APPLE_RTKIT_DIAG_INIT,
+	APPLE_RTKIT_DIAG_RX,
+	APPLE_RTKIT_DIAG_TX_BEGIN,
+	APPLE_RTKIT_DIAG_TX_END,
+	APPLE_RTKIT_DIAG_REINIT_BEGIN,
+	APPLE_RTKIT_DIAG_REINIT_END,
+};
+
+struct apple_rtkit_diag_record {
+	u64 seq, ns, msg0, msg1, tag;
+	int aux;
+	enum apple_rtkit_diag_event event;
+};
+
+struct apple_rtkit_diag_trace {
+	spinlock_t lock;
+	bool open;
+	u64 total;
+	struct apple_rtkit_diag_record records[APPLE_RTKIT_DIAG_TRACE_CAPACITY];
+};
+
+static u64 apple_rtkit_diag_record(struct apple_rtkit *rtk,
+				  enum apple_rtkit_diag_event event,
+				  u64 msg0, u64 msg1, u64 tag, int aux)
+{
+	struct apple_rtkit_diag_trace *trace = rtk->diag_trace;
+	struct apple_rtkit_diag_record *record;
+	unsigned long flags;
+	u64 seq = U64_MAX;
+
+	if (!trace)
+		return seq;
+	spin_lock_irqsave(&trace->lock, flags);
+	if (!trace->open)
+		goto unlock;
+	seq = trace->total++;
+	if (seq >= APPLE_RTKIT_DIAG_TRACE_CAPACITY)
+		goto unlock;
+	record = &trace->records[seq];
+	record->seq = seq;
+	record->ns = ktime_get_ns();
+	record->msg0 = msg0;
+	record->msg1 = msg1;
+	record->tag = tag;
+	record->aux = aux;
+	record->event = event;
+unlock:
+	spin_unlock_irqrestore(&trace->lock, flags);
+	return seq;
+}
+
+void apple_rtkit_diag_trace_dump(struct apple_rtkit *rtk, const char *phase,
+			       int result)
+{
+	static const char * const names[] = {
+		"INIT", "RX", "TX_BEGIN", "TX_END", "REINIT_BEGIN", "REINIT_END",
+	};
+	struct apple_rtkit_diag_trace *trace = rtk->diag_trace;
+	unsigned long flags;
+	u64 total, count, cutoff, i;
+
+	if (!trace) {
+		dev_err(rtk->dev, "RTKTRACE unavailable phase=%s ret=%d\n",
+			phase, result);
+		return;
+	}
+	spin_lock_irqsave(&trace->lock, flags);
+	if (!trace->open) {
+		spin_unlock_irqrestore(&trace->lock, flags);
+		return;
+	}
+	trace->open = false;
+	total = trace->total;
+	count = min_t(u64, total, APPLE_RTKIT_DIAG_TRACE_CAPACITY);
+	cutoff = ktime_get_ns();
+	spin_unlock_irqrestore(&trace->lock, flags);
+
+	/* Frozen records are immutable. Never print while holding the lock. */
+	dev_err(rtk->dev,
+		"RTKTRACE begin v=1 phase=%s ret=%d cap=%d count=%llu total=%llu dropped=%llu cutoff_ns=%llu\n",
+		phase, result, APPLE_RTKIT_DIAG_TRACE_CAPACITY, count, total,
+		total - count, cutoff);
+	for (i = 0; i < count; i++) {
+		const struct apple_rtkit_diag_record *r = &trace->records[i];
+
+		dev_err(rtk->dev,
+			"RTKTRACE seq=%llu ns=%llu event=%s ep=%02x msg0=%016llx msg1=%016llx tag=%llu aux=%d\n",
+			r->seq, r->ns, names[r->event], (u8)r->msg1,
+			r->msg0, r->msg1, r->tag, r->aux);
+	}
+	dev_err(rtk->dev, "RTKTRACE end count=%llu dropped=%llu\n",
+		count, total - count);
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_diag_trace_dump);
 
