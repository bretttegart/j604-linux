+/*
+ * C9 E4 diagnostic: m1n1's rtkit_boot sends IOP PWR STATE = INIT before
+ * expecting HELLO on every boot. Linux's branch 2 (cold) never sends it.
+ * Expose the send so the ANS boot path can match m1n1's construction.
+ */
+int apple_rtkit_send_iop_init(struct apple_rtkit *rtk)
+{
+	u64 msg;
+
+	msg = FIELD_PREP(APPLE_RTKIT_MGMT_PWR_STATE, APPLE_RTKIT_PWR_STATE_INIT);
+	return apple_rtkit_management_send(rtk, APPLE_RTKIT_MGMT_SET_IOP_PWR_STATE,
+					   msg);
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_send_iop_init);
+
