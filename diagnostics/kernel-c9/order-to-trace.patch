 EXPORT_SYMBOL_GPL(apple_rtkit_diag_trace_dump);
 
+void apple_rtkit_diag_trace_dump_mgmt(struct apple_rtkit *rtk, const char *phase,
+				      int result)
+{
+	static const char * const names[] = {
+		"INIT", "RX", "TX_BEGIN", "TX_END", "REINIT_BEGIN", "REINIT_END",
+	};
+	struct apple_rtkit_diag_trace *trace = rtk->diag_trace;
+	unsigned long flags;
+	u64 total, count, cutoff, i, printed = 0;
+
+	if (!trace) {
+		dev_err(rtk->dev, "RTKTRACE unavailable phase=%s ret=%d\n",
+			phase, result);
+		return;
+	}
+	spin_lock_irqsave(&trace->lock, flags);
+	if (!trace->open) {
+		spin_unlock_irqrestore(&trace->lock, flags);
+		return;
+	}
+	trace->open = false;
+	total = trace->total;
+	count = min_t(u64, total, APPLE_RTKIT_DIAG_TRACE_CAPACITY);
+	cutoff = ktime_get_ns();
+	spin_unlock_irqrestore(&trace->lock, flags);
+
+	/* Frozen records are immutable. Never print while holding the lock. */
+	dev_err(rtk->dev,
+		"RTKTRACE begin v=1 mgmt=1 phase=%s ret=%d cap=%d count=%llu total=%llu dropped=%llu cutoff_ns=%llu\n",
+		phase, result, APPLE_RTKIT_DIAG_TRACE_CAPACITY, count, total,
+		total - count, cutoff);
+	for (i = 0; i < count; i++) {
+		const struct apple_rtkit_diag_record *r = &trace->records[i];
+		u8 ep = (u8)r->msg1;
+		bool keep;
+
+		keep = (r->event == APPLE_RTKIT_DIAG_RX && (ep == 0 || ep == 1)) ||
+		       (r->event == APPLE_RTKIT_DIAG_TX_BEGIN && ep == 0) ||
+		       (r->event == APPLE_RTKIT_DIAG_TX_END && ep == 0) ||
+		       r->event == APPLE_RTKIT_DIAG_REINIT_BEGIN ||
+		       r->event == APPLE_RTKIT_DIAG_REINIT_END;
+		if (!keep)
+			continue;
+		printed++;
+		dev_err(rtk->dev,
+			"RTKTRACE seq=%llu ns=%llu event=%s ep=%02x msg0=%016llx msg1=%016llx tag=%llu aux=%d\n",
+			r->seq, r->ns, names[r->event], ep,
+			r->msg0, r->msg1, r->tag, r->aux);
+	}
+	dev_err(rtk->dev, "RTKTRACE end printed=%llu dropped=%llu\n",
+		printed, total - count);
+}
+EXPORT_SYMBOL_GPL(apple_rtkit_diag_trace_dump_mgmt);
